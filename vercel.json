{
  "version": 2,
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 9 */3 * *"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)",       "dest": "/api/$1" },
    { "src": "/qms-db.js",     "dest": "/qms-db.js" },
    { "src": "/qms-core.js",   "dest": "/qms-core.js" },
    { "src": "/qms-pages.js",  "dest": "/qms-pages.js" },
    { "src": "/qms-excel.js",  "dest": "/qms-excel.js" },
    { "src": "/qms-init.js",   "dest": "/qms-init.js" },
    { "src": "/qms-style.css", "dest": "/qms-style.css" },
    { "src": "/(.*)",          "dest": "/index.html" }
  ]
}
